# Public URLs
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTENT_REVALIDATE_SECONDS=300

# Analytics and search-engine verification (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Contact form SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-mailbox@example.com
SMTP_PASS=replace-with-smtp-password
CONTACT_FORM_TO=owner@example.com
CONTACT_FORM_FROM=your-mailbox@example.com
CONTACT_FORM_FROM_NAME=EA Website

# Set only to client-IP headers added by a trusted proxy, comma-separated.
TRUSTED_PROXY_IP_HEADERS=

# Optional writable directory for the persistent contact-form rate-limit cache.
# The default is .cache in the frontend working directory.
RATE_LIMIT_CACHE_DIR=
