# Runtime
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/ea

# Admin authentication
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_SAME_SITE=lax
ADMIN_EMAIL=admin@example.com
# Generate with: npm run hash:admin-password -- "your-password"
ADMIN_PASSWORD_HASH=

# Admin two-factor authentication (optional)
# Generate with: npm run generate:admin-2fa-secret
ADMIN_2FA_SECRET=
ADMIN_2FA_APP_NAME=EA Admin
ADMIN_2FA_EPOCH_TOLERANCE_SECONDS=30

# Express proxy trust: false, true, hop count, loopback, linklocal, or uniquelocal.
TRUST_PROXY=false

# Optional writable directory for the persistent API rate-limit cache.
# The default is .cache in the backend working directory.
RATE_LIMIT_CACHE_DIR=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ea-media
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev